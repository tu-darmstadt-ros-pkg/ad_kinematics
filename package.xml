<?xml version="1.0"?>
<package format="3">
  <name>ad_kinematics</name>
  <version>0.0.1</version>
  <description>This package provides templated kinematics calculations for use in ceres automatic differentiation.</description>

  <maintainer email="ros@martinoehler.de">Martin Oehler</maintainer>

  <license>BSD</license>

  <author email="ros@martinoehler.de">Martin Oehler</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>urdf</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
